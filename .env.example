# Credentials for the integration specs under test/integration/: attachments, estimates,
# glossaries, jobs, projects and translation-memory.
# Copy this file to .env and fill in real values to run: npm run test:integration
# Without a real .env, the integration suite skips (shows as pending) rather than failing.
#
# attachments.spec.ts creates a job, a glossary with an entry, an uploaded file and an issue in the
# account's first project. It deletes the job and the file, archives the glossary and resolves the
# issue, since those two cannot be deleted. The user needs account-owner, administrator or
# project-manager rights: the service only allows those roles to attach files to strings and
# glossaries. The attachments themselves are removed later by the service's hourly orphan cleanup.

# Optional: override the Smartling API base URL (defaults to https://api.smartling.com)
# SMARTLING_API_BASE_URL=https://api.smartling.com

SMARTLING_ACCOUNT_UID=
SMARTLING_USER_ID=
SMARTLING_USER_SECRET=

# Optional: set to "true" to print every integration test's raw API response to the console.
SMARTLING_LOG_RESPONSES=false
