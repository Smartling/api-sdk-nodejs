# Credentials for test/integration/glossaries.spec.ts and test/integration/translation-memory.spec.ts.
# Copy this file to .env and fill in real values to run: npm run test:integration
# Without a real .env, the integration suite skips (shows as pending) rather than failing.

# Optional: override the Smartling API base URL (defaults to https://api.smartling.com)
# SMARTLING_API_BASE_URL=https://api.smartling.com

SMARTLING_ACCOUNT_UID=
SMARTLING_USER_ID=
SMARTLING_USER_SECRET=

# Required by test/integration/translation-memory.spec.ts: UID of an existing translation
# memory in the account above to import TMX content into and export from. There is no
# create-TM endpoint in this SDK's scope, so this must point at a real, pre-existing TM.
SMARTLING_TM_UID=

# Optional: set to "true" to print every integration test's raw API response to the console.
SMARTLING_LOG_RESPONSES=false
